{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Setchy organization default Renovate config",
  "extends": [
    "config:best-practices",
    ":disableRateLimiting",
    ":enableVulnerabilityAlerts",
    ":semanticCommitTypeAll(chore)",
    ":separateMultipleMajorReleases",
    "customManagers:biomeVersions"
  ],
  "labels": ["dependency"],
  "rangeStrategy": "pin",
  "platformAutomerge": false,
  "reviewersFromCodeOwners": true,
  "packageRules": [
    {
      "matchDepTypes": ["engines"],
      "rangeStrategy": "auto"
    },
    {
      "description": "Remove word `dependency` from commit messages and PR titles",
      "matchDatasources": ["npm"],
      "commitMessageTopic": "{{depName}}"
    },
    {
      "description": "Group Node.js runtime updates across Docker images, nvm, nodenv, asdf, mise, engines, and devEngines",
      "matchDatasources": ["docker", "node-version"],
      "matchPackageNames": ["/(?:^|/)node$/"],
      "groupName": "node",
      "commitMessageTopic": "Node.js"
    },
    {
      "description": "Group @types/node updates with the Node.js runtime",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@types/node"],
      "groupName": "node",
      "commitMessageTopic": "Node.js"
    },
    {
      "description": "Auto-merge digest updates for setchy/renovate-config workflows",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["setchy/renovate-config"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    }
  ]
}
