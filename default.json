{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Setchy organization default Renovate config",
  "extends": [
    "config:best-practices",
    ":disableRateLimiting",
    ":enableVulnerabilityAlerts",
    ":semanticCommitTypeAll(chore)",
    ":separateMultipleMajorReleases",
    "customManagers:biomeVersions"
  ],
  "labels": ["dependency"],
  "rangeStrategy": "pin",
  "platformAutomerge": false,
  "reviewersFromCodeOwners": true,
  "packageRules": [
    {
      "matchDepTypes": ["engines"],
      "rangeStrategy": "auto"
    },
    {
      "description": "Remove word `dependency` from commit messages and PR titles",
      "matchDatasources": ["npm"],
      "commitMessageTopic": "{{depName}}"
    },
    {
      "description": "Auto-merge digest updates for setchy/renovate-config workflows",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["setchy/renovate-config"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    }
  ]
}
