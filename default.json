{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Setchy organization default Renovate config",
  "extends": [
    "config:best-practices",
    ":disableRateLimiting",
    ":enableVulnerabilityAlerts",
    ":semanticCommitTypeAll(chore)",
    ":separateMultipleMajorReleases",
    ":rebaseStalePrs",
    "group:vitePlus",
    "group:githubArtifactActions",
    "customManagers:biomeVersions",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "osvVulnerabilityAlerts": true,
  "labels": ["dependency"],
  "rangeStrategy": "pin",
  "reviewersFromCodeOwners": true,
  "packageRules": [
    {
      "description": "Pin npm dependency ranges by default",
      "matchManagers": ["npm"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Keep engine ranges (for example node) as ranges rather than pinning them",
      "matchDepTypes": ["engines"],
      "rangeStrategy": "auto"
    },
    {
      "description": "Use the dependency name in npm commit messages and PR titles",
      "matchDatasources": ["npm"],
      "commitMessageTopic": "{{depName}}"
    },
    {
      "description": "Group Node.js runtime updates across Docker images, nvm, nodenv, asdf, mise, engines, and devEngines",
      "matchDatasources": ["docker", "node-version"],
      "matchPackageNames": ["/(?:^|/)node$/"],
      "groupName": "node",
      "commitMessageTopic": "Node.js"
    },
    {
      "description": "Group @types/node updates with the Node.js runtime",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@types/node"],
      "groupName": "node",
      "commitMessageTopic": "Node.js"
    },
    {
      "description": "Keep the trusted reusable Renovate validator on its selected ref without digest pinning",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["setchy/renovate-config"],
      "pinDigests": false
    }
  ]
}
